{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Citadel Helm chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "secretEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string",
          "description": "Inline value; only rendered when secrets.create is true."
        },
        "existingSecret": {
          "type": "string",
          "description": "Name of an existing Secret holding this value."
        },
        "existingSecretKey": {
          "type": "string",
          "minLength": 1,
          "description": "Key within the existing Secret."
        }
      }
    },
    "probeTiming": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "httpPath": { "type": "string", "pattern": "^/" },
    "stringList": { "type": "array", "items": { "type": "string" } },
    "labelSelector": { "type": "object" }
  },
  "properties": {
    "global": { "type": "object" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": ["string", "number"] },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "updateStrategy": { "type": "object" },
    "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
    "devMode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inMemory": { "type": "boolean" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publicUrl": {
          "type": "string",
          "pattern": "^(https?://[^/?#@\\s]+(/[^?#\\s]*)?)?$",
          "description": "KMS_PUBLIC_URL: absolute http(s) URL without query, fragment or credentials."
        },
        "trustedProxies": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9a-fA-F:.]+(/[0-9]{1,3})?$" }
        },
        "awsRegion": { "type": "string", "pattern": "^([a-z]{2}(-[a-z]+)+-[0-9]+)?$" },
        "awsAccountId": { "type": "string", "pattern": "^([0-9]{12})?$" },
        "policyDefaultDeny": { "type": "boolean" },
        "uiSecureCookies": { "type": "boolean" },
        "sessionIdleTTL": { "type": "string", "pattern": "^(([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+)?$" },
        "sessionMaxTTL": { "type": "string", "pattern": "^(([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+)?$" },
        "pprofAddr": { "type": "string" }
      }
    },
    "extraEnv": { "type": "array" },
    "extraEnvFrom": { "type": "array" },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "keep": { "type": "boolean" },
        "existingSecret": { "type": "string" },
        "databaseUrl": { "$ref": "#/definitions/secretEntry" },
        "wrappingKey": { "$ref": "#/definitions/secretEntry" },
        "previousWrappingKeys": { "$ref": "#/definitions/secretEntry" },
        "auditHmacKey": { "$ref": "#/definitions/secretEntry" },
        "accessKeyId": { "$ref": "#/definitions/secretEntry" },
        "secretAccessKey": { "$ref": "#/definitions/secretEntry" },
        "bootstrapToken": { "$ref": "#/definitions/secretEntry" },
        "uiUsersJson": { "$ref": "#/definitions/secretEntry" },
        "masterKey": { "$ref": "#/definitions/secretEntry" }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "existingSecret": { "type": "string" }
      }
    },
    "workloadIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kubernetes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tokenReview": { "type": "boolean" },
            "reviewerTokenFile": { "type": "string" }
          }
        }
      }
    },
    "containerPort": { "type": "integer", "minimum": 1024, "maximum": 65535 },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" },
        "nodePort": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 },
        "externalTrafficPolicy": { "enum": ["", "Cluster", "Local"] }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host", "paths"],
            "properties": {
              "host": { "type": "string", "minLength": 1 },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["path"],
                  "properties": {
                    "path": { "$ref": "#/definitions/httpPath" },
                    "pathType": { "enum": ["Prefix", "Exact", "ImplementationSpecific"] }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "secretName": { "type": "string" },
              "hosts": { "$ref": "#/definitions/stringList" }
            }
          }
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "annotations": { "type": "object" },
        "parentRefs": {
          "type": "array",
          "items": { "type": "object", "required": ["name"] }
        },
        "hostnames": { "$ref": "#/definitions/stringList" },
        "matches": { "type": "array", "minItems": 1 }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "resources": { "type": "object" },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "livenessPath": { "$ref": "#/definitions/httpPath" },
        "readinessPath": { "$ref": "#/definitions/httpPath" },
        "startup": { "$ref": "#/definitions/probeTiming" },
        "liveness": { "$ref": "#/definitions/probeTiming" },
        "readiness": { "$ref": "#/definitions/probeTiming" }
      }
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 20 },
    "preStopSleepSeconds": { "type": "integer", "minimum": 0, "maximum": 60 },
    "podAntiAffinity": { "enum": ["", "soft", "hard"] },
    "podAntiAffinityTopologyKey": { "type": "string" },
    "topologySpreadConstraints": { "type": "array" },
    "affinity": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "priorityClassName": { "type": "string" },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "commonLabels": { "type": "object" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "maxUnavailable": { "type": ["integer", "string", "null"] },
        "minAvailable": { "type": ["integer", "string", "null"] }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 },
        "targetMemoryUtilizationPercentage": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespaceSelector": { "$ref": "#/definitions/labelSelector" },
            "podSelector": { "$ref": "#/definitions/labelSelector" },
            "allowSameNamespace": { "type": "boolean" },
            "extra": { "type": "array" }
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dns": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "namespaceSelector": { "$ref": "#/definitions/labelSelector" },
                "podSelector": { "$ref": "#/definitions/labelSelector" }
              }
            },
            "database": {
              "type": "object",
              "properties": {
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "cidrs": { "$ref": "#/definitions/stringList" },
                "namespaceSelector": { "$ref": "#/definitions/labelSelector" },
                "podSelector": { "$ref": "#/definitions/labelSelector" }
              }
            },
            "https": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "cidrs": { "$ref": "#/definitions/stringList" },
                "except": { "$ref": "#/definitions/stringList" }
              }
            },
            "http": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "cidrs": { "$ref": "#/definitions/stringList" },
                "except": { "$ref": "#/definitions/stringList" }
              }
            },
            "kubeApiServer": {
              "type": "object",
              "properties": {
                "cidrs": { "$ref": "#/definitions/stringList" },
                "ports": { "type": "array", "items": { "type": "integer" } }
              }
            },
            "extra": { "type": "array" }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "path": { "$ref": "#/definitions/httpPath" },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "namespace": { "type": "string" },
            "interval": { "type": "string" },
            "scrapeTimeout": { "type": "string" },
            "labels": { "type": "object" },
            "relabelings": { "type": "array" },
            "metricRelabelings": { "type": "array" }
          }
        }
      }
    }
  }
}
