# Copy to .env and replace every value, or run ./generate-env.sh, which does
# both. Never commit .env: it holds the key that decrypts the database.

# Image tag (release images drop the leading "v").
CITADEL_TAG=2.0.0
# Host port, bound to 127.0.0.1 only.
CITADEL_PORT=8080
KMS_PUBLIC_URL=http://localhost:8080

# PostgreSQL password, at least 14 characters (FIPS 140-3). Keep it URL-safe:
# it is embedded in KMS_DB_URL.   openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24

# 32 random bytes, base64.   openssl rand -base64 32
# Losing it makes everything in the database unreadable.
KMS_WRAPPING_KEY_B64=replace-with-openssl-rand-base64-32

# Audit chain HMAC key, at least 16 bytes.   openssl rand -base64 32
KMS_AUDIT_HMAC_KEY_B64=replace-with-openssl-rand-base64-32

# Retired wrapping keys during a rotation, comma separated. Usually empty.
KMS_PREVIOUS_WRAPPING_KEYS_B64=

# Optional one-time first-run setup token. Empty: the server generates one
# and prints it in its log.
KMS_BOOTSTRAP_TOKEN=
